# Server-side credentials. Never prefix these with VITE_.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Generate a random value with at least 32 characters; used to sign HttpOnly cookies.
FINCHAT_SESSION_SECRET=

# Shared secret configured in Pluggy webhook headers (X-Webhook-Secret) to authenticate notifications.
PLUGGY_WEBHOOK_SECRET=

# Supabase credentials (server-side only, never prefix with VITE_).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=



# Pluggy API credentials (server-side only)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Random secret with at least 32 characters for signed HttpOnly session cookies
FINCHAT_SESSION_SECRET=

# Supabase project hosting the dio-chat Edge Function (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: use only when dio-chat is hosted in a different Supabase project
DIO_CHAT_SUPABASE_URL=
DIO_CHAT_SUPABASE_SERVICE_ROLE_KEY=

# Optional: shared secret configured in Pluggy webhook headers (X-Webhook-Secret)
PLUGGY_WEBHOOK_SECRET=
